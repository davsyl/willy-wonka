{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@spinx/*": ["app/src/*"]
    }
  },
  "include": ["app/src/**/*", "tests/**/*"],
  "exclude": ["node_modules"]
}
